{
  "name": "@geohar/pi-acp",
  "version": "0.1.1",
  "description": "ACP adapter for pi coding agent (fork), with a bundled pi extension for subagent→plan",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "contributors": [
    "George Harker <george@georgeharker.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgeharker/pi-acp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/georgeharker/pi-acp/issues"
  },
  "homepage": "https://github.com/georgeharker/pi-acp#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "acp",
    "agent-client-protocol",
    "adapter",
    "subagent"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "src/pi-extension.ts"
  ],
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ]
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepare": "node -e \"try{require.resolve('tsup')}catch(e){process.exit(0)};require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
